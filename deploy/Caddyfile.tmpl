# Generated by install.sh from deploy/Caddyfile.tmpl. Variables in ${...}
# are substituted at install time; edit the template and re-run ./install.sh.
{
	email ${ACME_EMAIL}
	# Bound the wait for open connections on stop/reload; otherwise a lingering
	# client keeps Caddy alive until podman gives up and SIGKILLs it.
	grace_period 5s
	${CADDY_GLOBAL}
}
${ASK_SITE}
${SITE_ADDRESS} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	${WEB_DISCOVERY}
	reverse_proxy app:3080 {
		flush_interval -1
	}
}
${STALWART_SITE}
