{
	email ${ACME_EMAIL}
	${CADDY_GLOBAL}
}

${SITE_ADDRESS} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	reverse_proxy app:3080 {
		flush_interval -1
	}
}
${STALWART_SITE}
