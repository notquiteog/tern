#!/usr/bin/env bash
# Operator wrapper around podman-compose for a Tern install.
#   ./bin/tern up | down | restart [service] | ps | logs [service] | build
#   ./bin/tern cli <args>            run tern-cli inside the app container
#   ./bin/tern pull-model <name>     download an Ollama model
#   ./bin/tern dns-check [--port25]  verify the mail domain's DNS records from this box
#   ./bin/tern cert-sync             copy Caddy's certificate for the mail host into Stalwart
#   ./bin/tern stalwart-api '<methodCalls json>'   raw JMAP management call as the Stalwart admin
#   ./bin/tern stalwart-unban [ip…]  lift Stalwart's automatic IP bans (all, or the given addresses) and restart it
#   ./bin/tern stalwart-trust-proxy  never ban our own containers; trust X-Forwarded-For from them
#   ./bin/tern backup [dir]          dump the database and the .env into a dated tarball
#   ./bin/tern restore <tarball>     restore a backup made by `backup`
#   ./bin/tern update                same as ./update.sh
#   ./bin/tern compose <args>        raw podman-compose with the right files
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
[ -f .env ] || { echo "No .env yet; run ./install.sh first." >&2; exit 1; }
# .env is root-only (mode 600), so become root before reading it.
if [ "$(id -u)" -ne 0 ] && command -v sudo >/dev/null; then exec sudo -E "$0" "$@"; fi
# shellcheck disable=SC1091
set -a; . ./.env; set +a
export COMPOSE_FILE="${COMPOSE_FILE:-compose.yml}"
compose() { podman-compose --env-file "$ROOT/.env" "$@"; }
. "$ROOT/deploy/lib.sh"
# One JMAP management call to the bundled Stalwart, as its admin. Usage: sw_call '<methodCalls json>'
sw_call() { curl -sS -u "$STALWART_ADMIN_USER:$STALWART_ADMIN_PASSWORD" -H 'Content-Type: application/json' "http://127.0.0.1:${STALWART_HTTP_PORT:-8080}/jmap" -d "{\"using\":[\"urn:ietf:params:jmap:core\",\"urn:stalwart:jmap\"],\"methodCalls\":$1}"; }
stalwart_container() { podman ps -q --filter label=com.docker.compose.service=stalwart --filter "label=com.docker.compose.project.working_dir=$ROOT" | head -1; }

cmd="${1:-help}"; shift || true
case "$cmd" in
  up)        R="$(replace_stale_containers localhost/tern:latest | tr '\n' ' ')"; [ -n "$R" ] && echo "replacing (image changed): $R"; compose_up "$@" ;;
  down)      compose down "$@" ;;
  restart)   compose restart "$@" ;;
  ps)        compose ps "$@" ;;
  logs)      if [ -t 1 ]; then compose logs -f --tail=200 "$@"; else compose logs --tail=200 "$@"; fi ;;  # follow only on a terminal, so `| tail` works
  build)     compose build app "$@" ;;
  compose)   compose "$@" ;;
  cli)       compose exec -T app tern-cli "$@" ;;
  pull-model) compose exec -T ollama ollama pull "${1:?model name}" ;;
  dns-check) compose exec -T app tern-cli dns-check "$@" ;;
  update)    exec "$ROOT/update.sh" "$@" ;;
  stalwart-trust-proxy)
    # Caddy proxies every browser request to Stalwart, so without this one
    # visitor's failed logins (or a bot probing /admin) get Caddy's own
    # address banned and the admin panel answers 502 for everyone. Allow-list
    # the container network and trust X-Forwarded-For from it, so bans land
    # on the real client instead. Idempotent; install.sh runs it.
    [ "${STALWART_ENABLED:-0}" = 1 ] || { echo "Stalwart is not enabled."; exit 0; }
    command -v python3 >/dev/null || { echo "python3 is required for this command." >&2; exit 1; }
    SUBNETS="$(stack_subnets | tr '\n' ' ')"; [ -n "${SUBNETS// }" ] || SUBNETS="10.89.0.0/16"
    ALLOWED="$(sw_call '[["x:AllowedIp/get",{"ids":null,"properties":["address"]},"c1"]]')"
    for net in $SUBNETS; do
      if ! printf '%s' "$ALLOWED" | grep -q "\"address\":\"$net\""; then
        sw_call "[[\"x:AllowedIp/set\",{\"create\":{\"a\":{\"address\":\"$net\",\"reason\":\"Tern containers (Caddy, app)\"}}},\"c1\"]]" | grep -q '"created"' || { echo "could not allow-list $net" >&2; exit 1; }
      fi
    done
    CUR="$(sw_call '[["x:SystemSettings/get",{"ids":["singleton"],"properties":["proxyTrustedNetworks"]},"c1"]]')"
    MERGED="$(printf '%s' "$CUR" | python3 -c 'import json,sys; m=(json.load(sys.stdin)["methodResponses"][0][1]["list"][0].get("proxyTrustedNetworks") or {}); m.update({n: True for n in sys.argv[1:]}); print(json.dumps(m))' $SUBNETS)"
    sw_call "[[\"x:SystemSettings/set\",{\"update\":{\"singleton\":{\"proxyTrustedNetworks\":$MERGED}}},\"c1\"]]" | grep -q '"updated"' || { echo "could not set the trusted proxy networks" >&2; exit 1; }
    echo "Stalwart never bans and trusts X-Forwarded-For from: $SUBNETS" ;;
  stalwart-unban)
    # Stalwart keeps banned addresses in memory until it restarts, so
    # removing the entries alone is not enough.
    [ "${STALWART_ENABLED:-0}" = 1 ] || { echo "Stalwart is not enabled."; exit 0; }
    command -v python3 >/dev/null || { echo "python3 is required for this command." >&2; exit 1; }
    ROWS="$(sw_call '[["x:BlockedIp/get",{"ids":null,"properties":["address","reason"]},"c1"]]' | python3 -c 'import json,sys; want=set(sys.argv[1:]); l=json.load(sys.stdin)["methodResponses"][0][1]["list"]; [print(e["id"], e["address"], e.get("reason") or "-") for e in l if not want or e["address"] in want]' "$@")"
    [ -n "$ROWS" ] || { echo "No banned addresses${1:+ matching $*}."; exit 0; }
    printf '%s\n' "$ROWS" | while read -r _ addr reason; do echo "lifting ban on $addr ($reason)"; done
    IDS="$(printf '%s\n' "$ROWS" | awk '{ printf "%s\"%s\"", (NR > 1 ? "," : ""), $1 }')"
    sw_call "[[\"x:BlockedIp/set\",{\"destroy\":[$IDS]},\"c1\"]]" | grep -q '"destroyed"' || { echo "could not remove the bans" >&2; exit 1; }
    CID="$(stalwart_container)"
    echo "Restarting Stalwart so the lifted bans take effect…"
    if [ -n "$CID" ]; then podman restart "$CID" >/dev/null; else compose restart stalwart >/dev/null; fi
    echo "Done." ;;
  stalwart-api)
    [ "${STALWART_ENABLED:-0}" = 1 ] || { echo "Stalwart is not enabled." >&2; exit 1; }
    curl -sS -u "$STALWART_ADMIN_USER:$STALWART_ADMIN_PASSWORD" -H 'Content-Type: application/json' "http://127.0.0.1:${STALWART_HTTP_PORT:-8080}/jmap" \
      -d "{\"using\":[\"urn:ietf:params:jmap:core\",\"urn:stalwart:jmap\"],\"methodCalls\":${1:?methodCalls json}}"; echo ;;
  cert-sync)
    # Caddy owns 80/443 and therefore the ACME certificate for the mail host.
    # Stalwart needs the same certificate for SMTP/IMAP TLS, so copy it in
    # through the management API and make it the default. Idempotent; the
    # systemd timer runs it daily to pick up renewals.
    [ "${STALWART_ENABLED:-0}" = 1 ] || { echo "Stalwart is not enabled."; exit 0; }
    SW="http://127.0.0.1:${STALWART_HTTP_PORT:-8080}"
    api() { curl -sS -u "$STALWART_ADMIN_USER:$STALWART_ADMIN_PASSWORD" -H 'Content-Type: application/json' "$SW/jmap" -d "{\"using\":[\"urn:ietf:params:jmap:core\",\"urn:stalwart:jmap\"],\"methodCalls\":$1}"; }
    CERT_DIR="/data/caddy/certificates"
    CRT="$(podman run --rm -v tern_tern-caddy-data:/data:ro docker.io/library/alpine:3 sh -c "cat \$(find $CERT_DIR -path '*/$STALWART_HOST/$STALWART_HOST.crt' | head -1) 2>/dev/null" || true)"
    KEY="$(podman run --rm -v tern_tern-caddy-data:/data:ro docker.io/library/alpine:3 sh -c "cat \$(find $CERT_DIR -path '*/$STALWART_HOST/$STALWART_HOST.key' | head -1) 2>/dev/null" || true)"
    if [ -z "$CRT" ] || [ -z "$KEY" ]; then
      # Caddy asks for the certificate when it starts and then retries with a
      # growing backoff, so a name pointed here after that stays without one
      # for hours. Restart Caddy so it tries again now, then wait for the file.
      echo "No certificate for $STALWART_HOST in Caddy yet; restarting Caddy so it asks for one now…"
      CADDY="$(podman ps -q --filter label=com.docker.compose.service=caddy --filter "label=com.docker.compose.project.working_dir=$ROOT" | head -1)"
      if [ -n "$CADDY" ]; then podman restart "$CADDY" >/dev/null; else compose restart caddy >/dev/null 2>&1 || true; fi
      for i in $(seq 1 45); do
        sleep 2
        CRT="$(podman run --rm -v tern_tern-caddy-data:/data:ro docker.io/library/alpine:3 sh -c "cat \$(find $CERT_DIR -path '*/$STALWART_HOST/$STALWART_HOST.crt' | head -1) 2>/dev/null" || true)"
        [ -n "$CRT" ] && break
      done
      KEY="$(podman run --rm -v tern_tern-caddy-data:/data:ro docker.io/library/alpine:3 sh -c "cat \$(find $CERT_DIR -path '*/$STALWART_HOST/$STALWART_HOST.key' | head -1) 2>/dev/null" || true)"
      if [ -z "$CRT" ] || [ -z "$KEY" ]; then
        echo "Still no certificate for $STALWART_HOST after 90 s. Caddy's log lines about it:" >&2
        { [ -n "$CADDY" ] && podman logs --since 3m "$CADDY" 2>&1 || compose logs --tail=200 caddy 2>&1; } | grep -i "$STALWART_HOST" | grep -iv '"level":"info"' | tail -5 >&2
        echo "DNS must point here and port 80/443 must be reachable from the internet. Full log: ./bin/tern logs caddy" >&2
        exit 2
      fi
    fi
    esc() { python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()))' 2>/dev/null || { printf '"%s"' "$(sed ':a;N;$!ba;s/\n/\\n/g' | sed 's/"/\\"/g')"; }; }
    CRT_J="$(printf '%s\n' "$CRT" | esc)"; KEY_J="$(printf '%s\n' "$KEY" | esc)"
    EXISTING="$(api '[["x:Certificate/get",{"ids":null,"properties":["id","subjectAlternativeNames"]},"c1"]]' | sed -n "s/.*{\"id\":\"\([^\"]*\)\",\"subjectAlternativeNames\":{[^}]*\"$STALWART_HOST\".*/\1/p" | head -1)"
    if [ -z "$EXISTING" ]; then
      EXISTING="$(api '[["x:Certificate/get",{"ids":null,"properties":["id"]},"c1"]]' | sed -n 's/.*"list":\[{"id":"\([^"]*\)".*/\1/p')"
    fi
    if [ -n "$EXISTING" ]; then
      R="$(api "[[\"x:Certificate/set\",{\"update\":{\"$EXISTING\":{\"certificate\":{\"@type\":\"Text\",\"value\":$CRT_J},\"privateKey\":{\"@type\":\"Text\",\"secret\":$KEY_J}}}},\"c1\"]]")"
      CID="$EXISTING"
      echo "$R" | grep -q '"updated"' || { echo "update failed: $R" >&2; exit 1; }
    else
      R="$(api "[[\"x:Certificate/set\",{\"create\":{\"c\":{\"certificate\":{\"@type\":\"Text\",\"value\":$CRT_J},\"privateKey\":{\"@type\":\"Text\",\"secret\":$KEY_J}}}},\"c1\"]]")"
      CID="$(echo "$R" | sed -n 's/.*"created":{"c":{"id":"\([^"]*\)".*/\1/p')"
      [ -n "$CID" ] || { echo "create failed: $R" >&2; exit 1; }
    fi
    api "[[\"x:SystemSettings/set\",{\"update\":{\"singleton\":{\"defaultCertificateId\":\"$CID\"}}},\"c1\"]]" >/dev/null
    echo "Certificate for $STALWART_HOST installed in Stalwart (id $CID)." ;;
  backup)
    DEST="${1:-$ROOT/backups}"; mkdir -p "$DEST"
    STAMP="$(date +%Y%m%d-%H%M%S)"; TMP="$(mktemp -d)"
    compose exec -T db pg_dump -U tern -d tern --no-owner --format=custom > "$TMP/tern.pgdump"
    cp .env "$TMP/env"
    tar -C "$TMP" -czf "$DEST/tern-backup-$STAMP.tar.gz" tern.pgdump env
    rm -rf "$TMP"
    echo "Backup written to $DEST/tern-backup-$STAMP.tar.gz (database + .env; Ollama models and Stalwart data are not included)" ;;
  restore)
    TARBALL="${1:?path to backup tarball}"; TMP="$(mktemp -d)"
    tar -C "$TMP" -xzf "$TARBALL"
    echo "Restoring the database from $TARBALL (this replaces the current data)…"
    compose stop app >/dev/null
    compose exec -T db psql -U tern -d postgres -c "DROP DATABASE IF EXISTS tern_restore;" -c "CREATE DATABASE tern_restore OWNER tern;" >/dev/null
    compose exec -T db pg_restore -U tern -d tern_restore --no-owner < "$TMP/tern.pgdump"
    compose exec -T db psql -U tern -d postgres -c "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname='tern';" -c "DROP DATABASE tern;" -c "ALTER DATABASE tern_restore RENAME TO tern;" >/dev/null
    compose start app >/dev/null
    rm -rf "$TMP"
    echo "Restored. If the backup came from another machine, copy its ENCRYPTION_KEY into .env or mailbox credentials will not decrypt." ;;
  help|*)
    sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
