#!/usr/bin/env bash
# Operator wrapper around podman-compose for a Tern install.
#   ./bin/tern up | down | restart [service] | ps | logs [service] | build
#   ./bin/tern cli <args>            run tern-cli inside the app container
#   ./bin/tern pull-model <name>     download an Ollama model
#   ./bin/tern dns-check [--port25]  verify the mail domain's DNS records from this box
#   ./bin/tern cert-sync             copy Caddy's certificate for the mail host into Stalwart
#   ./bin/tern stalwart-api '<methodCalls json>'   raw JMAP management call as the Stalwart admin
#   ./bin/tern stalwart-unban [ip…]  lift Stalwart's automatic IP bans (all, or the given addresses) and restart it
#   ./bin/tern stalwart-trust-proxy  Stalwart listener for Caddy (PROXY protocol, real client addresses); never ban our containers
#   ./bin/tern doctor                 check containers, Stalwart, certificate, DNS, ports and disk
#   ./bin/tern backup [dir]          dump the database and the .env into a dated tarball
#   ./bin/tern restore <tarball>     restore a backup made by `backup`
#   ./bin/tern update                same as ./update.sh
#   ./bin/tern compose <args>        raw podman-compose with the right files
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
[ -f .env ] || { echo "No .env yet; run ./install.sh first." >&2; exit 1; }
# .env is root-only (mode 600), so become root before reading it.
if [ "$(id -u)" -ne 0 ] && command -v sudo >/dev/null; then exec sudo -E "$0" "$@"; fi
# shellcheck disable=SC1091
set -a; . ./.env; set +a
export COMPOSE_FILE="${COMPOSE_FILE:-compose.yml}"
compose() { podman-compose --env-file "$ROOT/.env" "$@"; }
. "$ROOT/deploy/lib.sh"
# One JMAP management call to the bundled Stalwart, as its admin. Usage: sw_call '<methodCalls json>'
# If Stalwart was told to expect the PROXY protocol on this network (an
# earlier version of stalwart-trust-proxy did that by mistake), plain HTTP is
# reset; curl can send the PROXY header itself, so retry that way.
sw_call() {
  local body="{\"using\":[\"urn:ietf:params:jmap:core\",\"urn:stalwart:jmap\"],\"methodCalls\":$1}" out
  out="$(curl -sS -m 20 -u "$STALWART_ADMIN_USER:$STALWART_ADMIN_PASSWORD" -H 'Content-Type: application/json' "http://127.0.0.1:${STALWART_HTTP_PORT:-8080}/jmap" -d "$body" 2>/dev/null)" && [ -n "$out" ] && { printf '%s' "$out"; return 0; }
  curl -sS -m 20 --haproxy-protocol -u "$STALWART_ADMIN_USER:$STALWART_ADMIN_PASSWORD" -H 'Content-Type: application/json' "http://127.0.0.1:${STALWART_HTTP_PORT:-8080}/jmap" -d "$body"
}
stalwart_container() { podman ps -q --filter label=com.docker.compose.service=stalwart --filter "label=com.docker.compose.project.working_dir=$ROOT" | head -1; }
# Wait until Stalwart's management API answers (after a restart it takes a few seconds).
sw_wait() { local i u="http://127.0.0.1:${STALWART_HTTP_PORT:-8080}/api/account"; for i in $(seq 1 30); do { curl -sf -m 5 -u "$STALWART_ADMIN_USER:$STALWART_ADMIN_PASSWORD" "$u" || curl -sf -m 5 --haproxy-protocol -u "$STALWART_ADMIN_USER:$STALWART_ADMIN_PASSWORD" "$u"; } >/dev/null 2>&1 && return 0; sleep 2; done; return 1; }

cmd="${1:-help}"; shift || true
case "$cmd" in
  up)        R="$(replace_stale_containers localhost/tern:latest | tr '\n' ' ')"; [ -n "$R" ] && echo "replacing (image changed): $R"; compose_up "$@" ;;
  down)      compose down "$@" ;;
  restart)   compose restart "$@" ;;
  ps)        compose ps "$@" ;;
  logs)      if [ -t 1 ]; then compose logs -f --tail=200 "$@"; else compose logs --tail=200 "$@"; fi ;;  # follow only on a terminal, so `| tail` works
  build)     compose build app "$@" ;;
  compose)   compose "$@" ;;
  cli)       compose exec -T app tern-cli "$@" ;;
  pull-model) compose exec -T ollama ollama pull "${1:?model name}" ;;
  dns-check) compose exec -T app tern-cli dns-check "$@" ;;
  update)    exec "$ROOT/update.sh" "$@" ;;
  stalwart-trust-proxy)
    # Caddy proxies every browser request to Stalwart, so without this one
    # visitor's failed logins (or a bot probing /admin) get Caddy's own
    # address banned and the admin panel answers 502 for everyone. Allow-list
    # the container network so our own containers are never banned.
    # Idempotent; install.sh and update.sh run it.
    [ "${STALWART_ENABLED:-0}" = 1 ] || { echo "Stalwart is not enabled."; exit 0; }
    command -v python3 >/dev/null || { echo "python3 is required for this command." >&2; exit 1; }
    sw_wait || { echo "Stalwart is not answering on port ${STALWART_HTTP_PORT:-8080}; see ./bin/tern logs stalwart" >&2; exit 1; }
    SUBNETS="$(stack_subnets | tr '\n' ' ')"; [ -n "${SUBNETS// }" ] || SUBNETS="10.89.0.0/16"
    ALLOWED="$(sw_call '[["x:AllowedIp/get",{"ids":null,"properties":["address"]},"c1"]]')"
    for net in $SUBNETS; do
      if ! printf '%s' "$ALLOWED" | grep -q "\"address\":\"$net\""; then
        sw_call "[[\"x:AllowedIp/set\",{\"create\":{\"a\":{\"address\":\"$net\",\"reason\":\"Tern containers (Caddy, app)\"}}},\"c1\"]]" | grep -q '"created"' || { echo "could not allow-list $net" >&2; exit 1; }
      fi
    done
    echo "Stalwart never bans: $SUBNETS"
    # A second HTTP listener on 8081 that expects the PROXY protocol from
    # our containers. Caddy sends it (deploy/stalwart-site.tmpl), so Stalwart
    # sees the visitor's real address and its bans hit the visitor. The app
    # and this host keep using the plain listener on 8080.
    LISTENERS="$(sw_call '[["x:NetworkListener/get",{"ids":null,"properties":["id","name","bind","overrideProxyTrustedNetworks"]},"c1"]]')"
    PLAN="$(printf '%s' "$LISTENERS" | python3 -c 'import json,sys
want={n: True for n in sys.argv[1:]}
l=json.load(sys.stdin)["methodResponses"][0][1]["list"]
cur=next((x for x in l if x.get("name")=="http-proxy"), None)
if cur is None: print("create")
elif (cur.get("overrideProxyTrustedNetworks") or {}) != want or list((cur.get("bind") or {}).keys()) != ["[::]:8081"]: print("update " + cur["id"])
else: print("ok")' $SUBNETS)"
    NETS_JSON="$(python3 -c 'import json,sys; print(json.dumps({n: True for n in sys.argv[1:]}))' $SUBNETS)"
    RESTART=0
    case "$PLAN" in
      create)
        sw_call "[[\"x:NetworkListener/set\",{\"create\":{\"l\":{\"name\":\"http-proxy\",\"protocol\":\"http\",\"bind\":{\"[::]:8081\":true},\"overrideProxyTrustedNetworks\":$NETS_JSON,\"useTls\":true,\"tlsImplicit\":false}}},\"c1\"]]" | grep -q '"created"' || { echo "could not create the http-proxy listener" >&2; exit 1; }
        echo "Created Stalwart listener http-proxy on port 8081 (PROXY protocol from $SUBNETS)"; RESTART=1 ;;
      update*)
        sw_call "[[\"x:NetworkListener/set\",{\"update\":{\"${PLAN#update }\":{\"bind\":{\"[::]:8081\":true},\"overrideProxyTrustedNetworks\":$NETS_JSON}}},\"c1\"]]" | grep -q '"updated"' || { echo "could not update the http-proxy listener" >&2; exit 1; }
        echo "Updated Stalwart listener http-proxy (PROXY protocol from $SUBNETS)"; RESTART=1 ;;
      *) echo "Stalwart listener http-proxy on 8081 is in place" ;;
    esac
    # An earlier version put these networks into Stalwart's global
    # PROXY-protocol trust list, which makes it reject plain HTTP from them.
    # Take them out again; listener changes and this apply after a restart.
    CUR="$(sw_call '[["x:SystemSettings/get",{"ids":["singleton"],"properties":["proxyTrustedNetworks"]},"c1"]]')"
    FIXED="$(printf '%s' "$CUR" | python3 -c 'import json,sys; m=(json.load(sys.stdin)["methodResponses"][0][1]["list"][0].get("proxyTrustedNetworks") or {}); drop=set(sys.argv[1:])|{"10.89.0.0/16"}; n={k:v for k,v in m.items() if k not in drop}; print(json.dumps(n) if n != m else "")' $SUBNETS)"
    if [ -n "$FIXED" ]; then
      sw_call "[[\"x:SystemSettings/set\",{\"update\":{\"singleton\":{\"proxyTrustedNetworks\":$FIXED}}},\"c1\"]]" | grep -q '"updated"' || { echo "could not clear the PROXY-protocol networks" >&2; exit 1; }
      echo "Removed our networks from Stalwart's global PROXY-protocol list"; RESTART=1
    fi
    if [ "$RESTART" = 1 ]; then
      CID="$(stalwart_container)"
      echo "Restarting Stalwart to apply…"
      if [ -n "$CID" ]; then podman restart "$CID" >/dev/null; else compose restart stalwart >/dev/null; fi
      sw_wait || { echo "Stalwart did not come back within 60 s; see ./bin/tern logs stalwart" >&2; exit 1; }
      echo "Stalwart is back."
    fi ;;
  stalwart-unban)
    # Stalwart keeps banned addresses in memory until it restarts, so
    # removing the entries alone is not enough.
    [ "${STALWART_ENABLED:-0}" = 1 ] || { echo "Stalwart is not enabled."; exit 0; }
    command -v python3 >/dev/null || { echo "python3 is required for this command." >&2; exit 1; }
    ROWS="$(sw_call '[["x:BlockedIp/get",{"ids":null,"properties":["address","reason"]},"c1"]]' | python3 -c 'import json,sys; want=set(sys.argv[1:]); l=json.load(sys.stdin)["methodResponses"][0][1]["list"]; [print(e["id"], e["address"], e.get("reason") or "-") for e in l if not want or e["address"] in want]' "$@")"
    [ -n "$ROWS" ] || { echo "No banned addresses${1:+ matching $*}."; exit 0; }
    printf '%s\n' "$ROWS" | while read -r _ addr reason; do echo "lifting ban on $addr ($reason)"; done
    IDS="$(printf '%s\n' "$ROWS" | awk '{ printf "%s\"%s\"", (NR > 1 ? "," : ""), $1 }')"
    sw_call "[[\"x:BlockedIp/set\",{\"destroy\":[$IDS]},\"c1\"]]" | grep -q '"destroyed"' || { echo "could not remove the bans" >&2; exit 1; }
    CID="$(stalwart_container)"
    echo "Restarting Stalwart so the lifted bans take effect…"
    if [ -n "$CID" ]; then podman restart "$CID" >/dev/null; else compose restart stalwart >/dev/null; fi
    sw_wait || { echo "Stalwart did not come back within 60 s; see ./bin/tern logs stalwart" >&2; exit 1; }
    echo "Done." ;;
  doctor)
    # A quick health picture of the install: what is up, what answers, what
    # the outside world sees. Each line is ok, warn or FAIL with a hint.
    okc() { printf '  \033[32m✓\033[0m %s\n' "$*"; }
    warnc() { printf '  \033[33m!\033[0m %s\n' "$*"; }
    failc() { printf '  \033[31m✗\033[0m %s\n' "$*"; PROBLEMS=$((PROBLEMS+1)); }
    PROBLEMS=0
    echo "Containers"
    for svc in $(compose config --services 2>/dev/null | grep -E '^[A-Za-z0-9_.-]+$'); do
      if compose exec -T "$svc" true >/dev/null 2>&1; then okc "$svc running"; else failc "$svc not running (./bin/tern logs $svc)"; fi
    done
    STALE="$(replace_stale_containers_dryrun 2>/dev/null | tr '\n' ' ')"
    if [ -n "${STALE// }" ]; then warnc "running an older image than the one on disk: $STALE (./bin/tern up replaces them)"; fi
    echo "App"
    if compose exec -T app wget -qO- http://127.0.0.1:3080/healthz >/dev/null 2>&1; then okc "app answers /healthz"; else failc "app does not answer /healthz (./bin/tern logs app)"; fi
    if [ -n "${APP_URL:-}" ]; then
      code="$(curl -s -m 10 -o /dev/null -w '%{http_code}' "$APP_URL/healthz" 2>/dev/null || true)"
      if [ "$code" = 200 ]; then okc "$APP_URL reachable with a valid certificate"; else failc "$APP_URL/healthz returned '${code:-no answer}' (DNS, firewall, or Caddy still fetching its certificate)"; fi
    fi
    if [ "${STALWART_ENABLED:-0}" = 1 ]; then
      echo "Mail server"
      if sw_wait; then okc "Stalwart management API answers on 127.0.0.1:${STALWART_HTTP_PORT:-8080}"; else failc "Stalwart management API not answering (./bin/tern logs stalwart)"; fi
      L="$(sw_call '[["x:NetworkListener/get",{"ids":null,"properties":["name","bind"]},"c1"]]' 2>/dev/null || true)"
      if printf '%s' "$L" | grep -q '"http-proxy"'; then okc "PROXY-protocol listener for Caddy (8081) exists"; else failc "no http-proxy listener; run ./bin/tern stalwart-trust-proxy"; fi
      if grep -q 'stalwart:8081' "$ROOT/deploy/generated/Caddyfile" 2>/dev/null; then okc "Caddy proxies the mail host to the PROXY-protocol listener"; else warnc "Caddyfile still points at stalwart:8080; ./update.sh regenerates it"; fi
      G="$(sw_call '[["x:SystemSettings/get",{"ids":["singleton"],"properties":["proxyTrustedNetworks"]},"c1"]]' 2>/dev/null || true)"
      if printf '%s' "$G" | grep -q '"proxyTrustedNetworks":{}'; then okc "global PROXY-protocol list is empty (plain HTTP on 8080 works)"; else warnc "global PROXY-protocol list is not empty; ./bin/tern stalwart-trust-proxy clears our networks"; fi
      B="$(sw_call '[["x:BlockedIp/get",{"ids":null,"properties":["address"]},"c1"]]' 2>/dev/null | grep -o '"address":"[^"]*"' | cut -d'"' -f4 | tr '\n' ' ' || true)"
      if [ -z "${B// }" ]; then okc "no banned addresses"; else warnc "banned addresses: $B (./bin/tern stalwart-unban lifts them)"; fi
      C="$(sw_call '[["x:Certificate/get",{"ids":null,"properties":["id","subjectAlternativeNames"]},"c1"]]' 2>/dev/null || true)"
      if printf '%s' "$C" | grep -q "\"$STALWART_HOST\""; then okc "TLS certificate for $STALWART_HOST installed in Stalwart"; else failc "no certificate for $STALWART_HOST in Stalwart (./bin/tern cert-sync)"; fi
      EXP="$(echo | timeout 8 openssl s_client -connect "127.0.0.1:465" -servername "$STALWART_HOST" 2>/dev/null | openssl x509 -noout -enddate 2>/dev/null | cut -d= -f2 || true)"
      if [ -n "$EXP" ]; then
        DAYS=$(( ( $(date -d "$EXP" +%s) - $(date +%s) ) / 86400 ))
        if [ "$DAYS" -lt 7 ]; then failc "certificate served on 465 expires in $DAYS days ($EXP)"; else okc "certificate served on 465 valid for $DAYS more days"; fi
      fi
      echo "DNS and ports"
      A="$(getent ahostsv4 "$STALWART_HOST" 2>/dev/null | awk '{print $1}' | sort -u | tr '\n' ' ' || true)"
      if [ -n "${SERVER_IP:-}" ] && printf '%s' "$A" | grep -qw "$SERVER_IP"; then okc "$STALWART_HOST resolves to $SERVER_IP"; else failc "$STALWART_HOST resolves to '${A:-nothing}', expected ${SERVER_IP:-?}"; fi
      R="$(getent hosts "${SERVER_IP:-0.0.0.0}" 2>/dev/null | awk '{print $2}' || true)"
      if [ "${R%.}" = "$STALWART_HOST" ]; then okc "reverse DNS of $SERVER_IP is $STALWART_HOST"; else warnc "reverse DNS of ${SERVER_IP:-?} is '${R:-unset}', should be $STALWART_HOST (set it at your hosting provider)"; fi
      for p in 25 465 587 993; do
        if ss -ltn 2>/dev/null | awk '{print $4}' | grep -qE "[:.]$p$"; then okc "port $p listening"; else failc "nothing listening on port $p"; fi
      done
      echo "  Outbound port 25 and the public view: ./bin/tern dns-check --port25"
    fi
    echo "Host"
    DF="$(df -P / | awk 'NR==2 {print $5}' | tr -d % || true)"
    if [ "${DF:-0}" -ge 90 ]; then failc "disk ${DF}% full"; elif [ "${DF:-0}" -ge 80 ]; then warnc "disk ${DF}% full"; else okc "disk ${DF}% used"; fi
    MEM="$(awk '/MemAvailable/ {printf "%d", $2/1024}' /proc/meminfo)"; if [ "${MEM:-0}" -lt 300 ]; then warnc "only ${MEM} MB of memory available"; else okc "${MEM} MB of memory available"; fi
    if command -v timedatectl >/dev/null && timedatectl show -p NTPSynchronized --value 2>/dev/null | grep -q yes; then okc "clock synchronised"; else warnc "clock not confirmed as synchronised (TLS and DKIM need accurate time)"; fi
    if [ "$PROBLEMS" = 0 ]; then echo "All checks passed."; else echo "$PROBLEMS problem(s) found." ; exit 1; fi ;;
  stalwart-api)
    [ "${STALWART_ENABLED:-0}" = 1 ] || { echo "Stalwart is not enabled." >&2; exit 1; }
    curl -sS -u "$STALWART_ADMIN_USER:$STALWART_ADMIN_PASSWORD" -H 'Content-Type: application/json' "http://127.0.0.1:${STALWART_HTTP_PORT:-8080}/jmap" \
      -d "{\"using\":[\"urn:ietf:params:jmap:core\",\"urn:stalwart:jmap\"],\"methodCalls\":${1:?methodCalls json}}"; echo ;;
  cert-sync)
    # Caddy owns 80/443 and therefore the ACME certificate for the mail host.
    # Stalwart needs the same certificate for SMTP/IMAP TLS, so copy it in
    # through the management API and make it the default. Idempotent; the
    # systemd timer runs it daily to pick up renewals.
    [ "${STALWART_ENABLED:-0}" = 1 ] || { echo "Stalwart is not enabled."; exit 0; }
    sw_wait || { echo "Stalwart is not answering on port ${STALWART_HTTP_PORT:-8080}; see ./bin/tern logs stalwart" >&2; exit 1; }
    SW="http://127.0.0.1:${STALWART_HTTP_PORT:-8080}"
    api() { curl -sS -u "$STALWART_ADMIN_USER:$STALWART_ADMIN_PASSWORD" -H 'Content-Type: application/json' "$SW/jmap" -d "{\"using\":[\"urn:ietf:params:jmap:core\",\"urn:stalwart:jmap\"],\"methodCalls\":$1}"; }
    CERT_DIR="/data/caddy/certificates"
    CRT="$(podman run --rm -v tern_tern-caddy-data:/data:ro docker.io/library/alpine:3 sh -c "cat \$(find $CERT_DIR -path '*/$STALWART_HOST/$STALWART_HOST.crt' | head -1) 2>/dev/null" || true)"
    KEY="$(podman run --rm -v tern_tern-caddy-data:/data:ro docker.io/library/alpine:3 sh -c "cat \$(find $CERT_DIR -path '*/$STALWART_HOST/$STALWART_HOST.key' | head -1) 2>/dev/null" || true)"
    if [ -z "$CRT" ] || [ -z "$KEY" ]; then
      # Caddy asks for the certificate when it starts and then retries with a
      # growing backoff, so a name pointed here after that stays without one
      # for hours. Restart Caddy so it tries again now, then wait for the file.
      echo "No certificate for $STALWART_HOST in Caddy yet; restarting Caddy so it asks for one now…"
      CADDY="$(podman ps -q --filter label=com.docker.compose.service=caddy --filter "label=com.docker.compose.project.working_dir=$ROOT" | head -1)"
      if [ -n "$CADDY" ]; then podman restart "$CADDY" >/dev/null; else compose restart caddy >/dev/null 2>&1 || true; fi
      for i in $(seq 1 45); do
        sleep 2
        CRT="$(podman run --rm -v tern_tern-caddy-data:/data:ro docker.io/library/alpine:3 sh -c "cat \$(find $CERT_DIR -path '*/$STALWART_HOST/$STALWART_HOST.crt' | head -1) 2>/dev/null" || true)"
        [ -n "$CRT" ] && break
      done
      KEY="$(podman run --rm -v tern_tern-caddy-data:/data:ro docker.io/library/alpine:3 sh -c "cat \$(find $CERT_DIR -path '*/$STALWART_HOST/$STALWART_HOST.key' | head -1) 2>/dev/null" || true)"
      if [ -z "$CRT" ] || [ -z "$KEY" ]; then
        echo "Still no certificate for $STALWART_HOST after 90 s. Caddy's log lines about it:" >&2
        { [ -n "$CADDY" ] && podman logs --since 3m "$CADDY" 2>&1 || compose logs --tail=200 caddy 2>&1; } | grep -i "$STALWART_HOST" | grep -iv '"level":"info"' | tail -5 >&2
        echo "DNS must point here and port 80/443 must be reachable from the internet. Full log: ./bin/tern logs caddy" >&2
        exit 2
      fi
    fi
    esc() { python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()))' 2>/dev/null || { printf '"%s"' "$(sed ':a;N;$!ba;s/\n/\\n/g' | sed 's/"/\\"/g')"; }; }
    CRT_J="$(printf '%s\n' "$CRT" | esc)"; KEY_J="$(printf '%s\n' "$KEY" | esc)"
    EXISTING="$(api '[["x:Certificate/get",{"ids":null,"properties":["id","subjectAlternativeNames"]},"c1"]]' | sed -n "s/.*{\"id\":\"\([^\"]*\)\",\"subjectAlternativeNames\":{[^}]*\"$STALWART_HOST\".*/\1/p" | head -1)"
    if [ -z "$EXISTING" ]; then
      EXISTING="$(api '[["x:Certificate/get",{"ids":null,"properties":["id"]},"c1"]]' | sed -n 's/.*"list":\[{"id":"\([^"]*\)".*/\1/p')"
    fi
    if [ -n "$EXISTING" ]; then
      R="$(api "[[\"x:Certificate/set\",{\"update\":{\"$EXISTING\":{\"certificate\":{\"@type\":\"Text\",\"value\":$CRT_J},\"privateKey\":{\"@type\":\"Text\",\"secret\":$KEY_J}}}},\"c1\"]]")"
      CID="$EXISTING"
      echo "$R" | grep -q '"updated"' || { echo "update failed: $R" >&2; exit 1; }
    else
      R="$(api "[[\"x:Certificate/set\",{\"create\":{\"c\":{\"certificate\":{\"@type\":\"Text\",\"value\":$CRT_J},\"privateKey\":{\"@type\":\"Text\",\"secret\":$KEY_J}}}},\"c1\"]]")"
      CID="$(echo "$R" | sed -n 's/.*"created":{"c":{"id":"\([^"]*\)".*/\1/p')"
      [ -n "$CID" ] || { echo "create failed: $R" >&2; exit 1; }
    fi
    api "[[\"x:SystemSettings/set\",{\"update\":{\"singleton\":{\"defaultCertificateId\":\"$CID\"}}},\"c1\"]]" >/dev/null
    echo "Certificate for $STALWART_HOST installed in Stalwart (id $CID)." ;;
  backup)
    DEST="${1:-$ROOT/backups}"; mkdir -p "$DEST"
    STAMP="$(date +%Y%m%d-%H%M%S)"; TMP="$(mktemp -d)"
    compose exec -T db pg_dump -U tern -d tern --no-owner --format=custom > "$TMP/tern.pgdump"
    cp .env "$TMP/env"
    tar -C "$TMP" -czf "$DEST/tern-backup-$STAMP.tar.gz" tern.pgdump env
    rm -rf "$TMP"
    echo "Backup written to $DEST/tern-backup-$STAMP.tar.gz (database + .env; Ollama models and Stalwart data are not included)" ;;
  restore)
    TARBALL="${1:?path to backup tarball}"; TMP="$(mktemp -d)"
    tar -C "$TMP" -xzf "$TARBALL"
    echo "Restoring the database from $TARBALL (this replaces the current data)…"
    compose stop app >/dev/null
    compose exec -T db psql -U tern -d postgres -c "DROP DATABASE IF EXISTS tern_restore;" -c "CREATE DATABASE tern_restore OWNER tern;" >/dev/null
    compose exec -T db pg_restore -U tern -d tern_restore --no-owner < "$TMP/tern.pgdump"
    compose exec -T db psql -U tern -d postgres -c "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname='tern';" -c "DROP DATABASE tern;" -c "ALTER DATABASE tern_restore RENAME TO tern;" >/dev/null
    compose start app >/dev/null
    rm -rf "$TMP"
    echo "Restored. If the backup came from another machine, copy its ENCRYPTION_KEY into .env or mailbox credentials will not decrypt." ;;
  help|*)
    sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
