# Copy of what install.sh writes. You normally never edit this by hand:
# re-run ./install.sh and it walks you through every value again, keeping
# what you already chose as the default.

# Public URL of the web app (no trailing slash). https://mail.example.com or http://203.0.113.10:8080
APP_URL=https://outreach.example.com
# Address Caddy serves. "https://outreach.example.com" for a domain, or ":80" for plain HTTP on an IP.
SITE_ADDRESS=https://outreach.example.com
ACME_EMAIL=you@example.com
HTTP_PORT=80
HTTPS_PORT=443

# Secrets. Generated once; losing ENCRYPTION_KEY means re-entering every mailbox credential.
DB_PASSWORD=
SESSION_SECRET=
ENCRYPTION_KEY=

# AI model served by the bundled Ollama. Chosen from the machine's RAM on install.
AI_MODEL=qwen2.5:1.5b
AI_ENABLED=true

# Sync tuning
SYNC_POLL_SECONDS=90
INITIAL_SYNC_LIMIT=3000
# Plain-http JMAP session URLs (needed for the bundled Stalwart on the compose network).
ALLOW_INSECURE_JMAP=true
# Let people connect JMAP or SMTP servers on private/LAN addresses. Off by
# default: otherwise any member could point the server at the internal
# network (Ollama, Postgres, Stalwart's admin API). The bundled Stalwart is
# always allowed. See docs/SECURITY.md.
ALLOW_PRIVATE_NETWORK_HOSTS=false

# Compose overlays (colon separated). install.sh adds compose.stalwart.yml and compose.gpu.yml here.
COMPOSE_FILE=compose.yml

# Bundled Stalwart (only when enabled)
STALWART_ENABLED=0
STALWART_HOST=
STALWART_DOMAIN=
STALWART_HTTP_PORT=8080
STALWART_ADMIN_USER=
STALWART_ADMIN_PASSWORD=
STALWART_RECOVERY_ADMIN=
STALWART_RECOVERY_MODE=
